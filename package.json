{
  "name": "dacom-recursos",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter api dev",
    "dev:web": "pnpm --filter utfpr-dacom-frontend dev",
    "lint": "pnpm --filter utfpr-dacom-frontend lint",
    "test": "pnpm --filter api test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "effect@<3.22.1": "^3.22.1"
    }
  }
}
