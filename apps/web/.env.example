# URL do backend Node.js/Express usada pelo proxy do Vite (/api -> VITE_API_URL)
VITE_API_URL=http://localhost:3000

# Controla a ativação do Mock Service Worker (MSW) no navegador
# true  -> Intercepta chamadas /api/* localmente via MSW (desenvolvimento/QA isolado)
# false -> Repassa chamadas /api/* para a API real via proxy do Vite
VITE_ENABLE_MSW=true

