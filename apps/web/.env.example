# URL do backend Node.js/Express usada pelo proxy do Vite (/api -> VITE_API_URL)
VITE_API_URL=http://localhost:3000

# Controla a ativação do Mock Service Worker (MSW) no navegador
# false -> Repassa chamadas /api/* para a API real via proxy do Vite (padrão)
# true  -> Intercepta chamadas /api/* localmente via MSW (só para QA isolado:
#          o mock pode divergir do contrato real da API)
VITE_ENABLE_MSW=false

