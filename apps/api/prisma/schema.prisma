// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}



enum StatusSolicitacao {
  CRIADA
  AGUARDANDO_COMPLEMENTO
  EM_VOTACAO
  PROVISIONADA
  PAGA
  REJEITADA
  CANCELADA
}

enum TipoMovimentacao {
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  PROVISAO
  ESTORNO
  UTILIZACAO
}


model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  solicitacoes Solicitacao[]
  pagamentos   Pagamento[]
}

model Orcamento {
  id           Int      @id @default(autoincrement())
  ano          Int      @unique
  valorInicial Decimal  @db.Decimal(14, 2)
  criadoEm     DateTime @default(now())

  solicitacoes  Solicitacao[]
  movimentacoes Movimentacao[]
}

model LimiteAprovacao {
  id           Int       @id @default(autoincrement())
  valor        Decimal   @db.Decimal(14, 2)
  periodoMeses Int
  vigenteDesde DateTime
  vigenteAte   DateTime? // null = ainda vigente

  solicitacoes Solicitacao[]
}

model Categoria {
  id    Int     @id @default(autoincrement())
  nome  String  @unique
  ativa Boolean @default(true)

  solicitacoes Solicitacao[]
}

model Solicitacao {
  id          Int               @id @default(autoincrement())
  professorId Int
  categoriaId Int
  orcamentoId Int
  limiteId    Int // qual limite valia na avaliação (RN01)
  descricao   String
  valor       Decimal           @db.Decimal(14, 2)
  finalidade  String
  status      StatusSolicitacao @default(CRIADA)
  criadaEm    DateTime          @default(now())

  professor Usuario         @relation(fields: [professorId], references: [id])
  categoria Categoria       @relation(fields: [categoriaId], references: [id])
  orcamento Orcamento       @relation(fields: [orcamentoId], references: [id])
  limite    LimiteAprovacao @relation(fields: [limiteId], references: [id])

  movimentacoes Movimentacao[]
  pagamento     Pagamento?

  @@index([professorId, criadaEm]) // consulta do acumulado por professor
  @@index([status])
}

// Append-only: nunca UPDATE nem DELETE. valor é sempre > 0 (CHECK na migration).
model Movimentacao {
  id            Int              @id @default(autoincrement())
  orcamentoId   Int
  solicitacaoId Int? // null nos ajustes manuais
  tipo          TipoMovimentacao
  valor         Decimal          @db.Decimal(14, 2)
  criadaEm      DateTime         @default(now())

  orcamento   Orcamento    @relation(fields: [orcamentoId], references: [id])
  solicitacao Solicitacao? @relation(fields: [solicitacaoId], references: [id])

  @@index([orcamentoId, tipo])
  @@index([solicitacaoId])
}

model Pagamento {
  id              Int      @id @default(autoincrement())
  solicitacaoId   Int      @unique // garante 1 pagamento por solicitação (idempotência)
  registradoPorId Int
  valorPago       Decimal  @db.Decimal(14, 2)
  justificativa   String? // obrigatória se valorPago != provisionado (RN15), validada no service
  pagoEm          DateTime @default(now())

  solicitacao   Solicitacao @relation(fields: [solicitacaoId], references: [id])
  registradoPor Usuario     @relation(fields: [registradoPorId], references: [id])
}
