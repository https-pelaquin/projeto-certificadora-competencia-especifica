# Copie para apps/api/.env e ajuste. Nunca versione o .env.
NODE_ENV=development
PORT=3000

# Banco (docker compose expõe o PostgreSQL na porta 5433)
DATABASE_URL=postgresql://dacom:dacom@localhost:5433/dacom
# Banco recriado a cada execução dos testes
TEST_DATABASE_URL=postgresql://dacom:dacom@localhost:5433/dacom_test

# Sessão: gere com `openssl rand -hex 32`
SESSION_SECRET=

# E-mail (Mailpit em desenvolvimento: interface em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DACOM Recursos <nao-responda@dacom.local>"

# URL do frontend (links dos e-mails) e origem liberada no CORS
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Primeiro chefe criado pelo seed (pnpm db:seed)
SEED_HEAD_NAME=
SEED_HEAD_EMAIL=
SEED_HEAD_PASSWORD=
